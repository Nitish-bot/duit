{
  "functions": [
    {
      "source": "functions/development",
      "codebase": "development-only",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".runtimeconfig.json",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
